# Development is mock by default and makes no network requests.
NODE_ENV=development
INTAKE_EMAIL_MODE=mock
PORT=8787
INTAKE_INTERNAL_EMAIL=langsystemsdesign@outlook.com
LANG_SYSTEMS_CONTACT_EMAIL=langsystemsdesign@outlook.com
INTAKE_ALLOWED_ORIGIN=http://127.0.0.1:8787
# Use an absolute, non-public path. This file contains delivery metadata, not form answers.
INTAKE_STATUS_FILE=C:\path\outside\the\public-site\delivery-status.json

# Production only:
# NODE_ENV=production
# INTAKE_EMAIL_MODE=live
# RESEND_API_KEY=
# EMAIL_FROM=Lang Systems <projects@langsystems.com.au>
# EMAIL_PROVIDER_URL=https://api.resend.com/emails
# INTAKE_ALLOWED_ORIGIN=https://langsystems.com.au
# INTAKE_REVIEW_BASE_URL=https://secure-internal-review.example/submissions
